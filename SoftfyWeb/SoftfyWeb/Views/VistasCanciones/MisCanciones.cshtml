@model IEnumerable<SoftfyWeb.Modelos.Dtos.CancionRespuestaDto>
@{
    ViewData["Title"] = "Mis Canciones";
}

<h2>@ViewData["Title"]</h2>

<p>
    <a asp-action="CrearCancion" class="btn btn-primary">Nueva Canción</a>
</p>

<table class="table table-bordered">
    <thead>
        <tr>
            <th>Título</th>
            <th>Género</th>
            <th>Fecha</th>
            <th>Archivo</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var c in Model)
        {
            <tr>
                <td>@c.Titulo</td>
                <td>@c.Genero</td>
                <td>@c.FechaLanzamiento.ToString("yyyy-MM-dd")</td>
                <td>
                    <audio controls>
                        <source src="@c.UrlArchivo" type="audio/mpeg" />
                        Tu navegador no soporta audio.
                    </audio>
                </td>
            </tr>
        }
    </tbody>
</table>
